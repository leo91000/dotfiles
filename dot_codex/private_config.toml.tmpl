[mcp_servers.playwright]
command = "pnpx"
args = ["@playwright/mcp@latest", "--extension"]

[mcp_servers.playwright.env]
DBUS_SESSION_BUS_ADDRESS = "unix:path=/run/user/1000/bus"
DISPLAY = ":0"
PLAYWRIGHT_MCP_EXTENSION_TOKEN = "{{ onepasswordRead "op://Private/playwright-mcp-extension-token/credential" }}"
WAYLAND_DISPLAY = "wayland-1"
XDG_RUNTIME_DIR = "/run/user/1000"

[mcp_servers.context7]
url = "https://mcp.context7.com/mcp"

[mcp_servers.context7.http_headers]
CONTEXT7_API_KEY = "{{ onepasswordRead "op://Private/context7-codex-api-key/credential" }}"

[mcp_servers.atlassian-rovo]
url = "https://mcp.atlassian.com/v1/mcp"

[mcp_servers.openaiDeveloperDocs]
url = "https://developers.openai.com/mcp"

[notice]
hide_gpt5_1_migration_prompt = true
hide_rate_limit_model_nudge = true
fast_default_opt_out = true

[notice.model_migrations]
