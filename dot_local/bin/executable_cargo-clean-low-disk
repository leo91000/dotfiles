#!/usr/bin/env bash

set -u
set -o pipefail

readonly SCAN_ROOT="${CARGO_CLEAN_SCAN_ROOT:-/home/leoc/projects}"
readonly WATCH_PATH="${CARGO_CLEAN_WATCH_PATH:-$SCAN_ROOT}"
readonly LOW_WATERMARK_GIB="${CARGO_CLEAN_LOW_GIB:-200}"
readonly HIGH_WATERMARK_GIB="${CARGO_CLEAN_HIGH_GIB:-250}"
readonly GIB=$((1024 * 1024 * 1024))

dry_run=false

log() {
    printf 'cargo-clean-low-disk: %s\n' "$*"
}

usage() {
    cat <<'EOF'
Usage: cargo-clean-low-disk [--dry-run]

Clean Cargo target directories below the configured disk-space watermark.

  --dry-run  Discover and rank targets without deleting anything.
EOF
}

available_bytes() {
    df --block-size=1 --output=avail "$WATCH_PATH" | awk 'NR == 2 { print $1 }'
}

human_bytes() {
    numfmt --to=iec-i --suffix=B "$1"
}

for argument in "$@"; do
    case "$argument" in
        --dry-run)
            dry_run=true
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            log "unknown argument: $argument"
            usage >&2
            exit 2
            ;;
    esac
done

if [[ ! "$LOW_WATERMARK_GIB" =~ ^[0-9]+$ || ! "$HIGH_WATERMARK_GIB" =~ ^[0-9]+$ ]]; then
    log "watermarks must be non-negative integer GiB values"
    exit 2
fi

if (( HIGH_WATERMARK_GIB <= LOW_WATERMARK_GIB )); then
    log "high watermark must be greater than low watermark"
    exit 2
fi

readonly LOW_WATERMARK_BYTES=$((LOW_WATERMARK_GIB * GIB))
readonly HIGH_WATERMARK_BYTES=$((HIGH_WATERMARK_GIB * GIB))

if [[ ! -d "$SCAN_ROOT" || ! -d "$WATCH_PATH" ]]; then
    log "scan root or watched path does not exist"
    exit 1
fi

readonly lock_dir="${XDG_RUNTIME_DIR:-/tmp}"
exec 9>"$lock_dir/cargo-clean-low-disk-${UID}.lock"
if ! flock --nonblock 9; then
    log "another cleanup is already running"
    exit 0
fi

available="$(available_bytes)"
if [[ ! "$available" =~ ^[0-9]+$ ]]; then
    log "could not determine available disk space"
    exit 1
fi

if [[ "$dry_run" == false ]] && (( available >= LOW_WATERMARK_BYTES )); then
    log "$(human_bytes "$available") available; cleanup threshold is ${LOW_WATERMARK_GIB} GiB"
    exit 0
fi

if [[ "$dry_run" == false ]] && { pgrep --uid "$UID" --exact cargo >/dev/null || pgrep --uid "$UID" --exact rustc >/dev/null; }; then
    log "disk is below the threshold, but a Cargo or rustc process is active; postponing cleanup"
    exit 0
fi

log "discovering Cargo workspaces under $SCAN_ROOT"

declare -A workspace_manifests=()
declare -A target_manifests=()

while IFS= read -r -d '' manifest; do
    workspace_manifest="$(
        cargo locate-project \
            --workspace \
            --message-format plain \
            --manifest-path "$manifest" \
            2>/dev/null
    )" || workspace_manifest="$manifest"

    workspace_manifests["$workspace_manifest"]=1
done < <(fd --hidden --type file --print0 '^Cargo\.toml$' "$SCAN_ROOT" --exclude target)

for manifest in "${!workspace_manifests[@]}"; do
    metadata="$(
        cargo metadata \
            --no-deps \
            --format-version 1 \
            --manifest-path "$manifest" \
            2>/dev/null
    )" || {
        log "skipping workspace whose metadata could not be read: $manifest"
        continue
    }

    target="$(jq --raw-output '.target_directory // empty' <<<"$metadata")"
    if [[ -n "$target" && -d "$target" ]]; then
        target_manifests["$target"]="$manifest"
    fi
done

if (( ${#target_manifests[@]} == 0 )); then
    log "no Cargo target directories found"
    exit 0
fi

candidate_file="$(mktemp --tmpdir="$lock_dir" cargo-clean-low-disk.XXXXXX)"
trap 'rm -f "$candidate_file"' EXIT
watch_device="$(stat --format=%d "$WATCH_PATH")"

for target in "${!target_manifests[@]}"; do
    if [[ "$(stat --format=%d "$target")" != "$watch_device" ]]; then
        continue
    fi

    size="$(du --summarize --block-size=1 "$target" 2>/dev/null | awk '{ print $1 }')"
    if [[ "$size" =~ ^[0-9]+$ ]]; then
        printf '%s\t%s\n' "$size" "$target" >>"$candidate_file"
    fi
done

sort --numeric-sort --reverse --output="$candidate_file" "$candidate_file"

if [[ "$dry_run" == true ]]; then
    log "dry run; $(human_bytes "$available") currently available"
    while IFS=$'\t' read -r size target; do
        log "would clean $(human_bytes "$size") from $target"
    done <"$candidate_file"
    exit 0
fi

while IFS=$'\t' read -r size target; do
    available="$(available_bytes)"
    if (( available >= HIGH_WATERMARK_BYTES )); then
        log "reached the ${HIGH_WATERMARK_GIB} GiB target with $(human_bytes "$available") available"
        exit 0
    fi

    manifest="${target_manifests[$target]}"
    log "cleaning $(human_bytes "$size") target $target"
    if ! cargo clean --manifest-path "$manifest" --target-dir "$target"; then
        log "cargo clean failed for $target; continuing with the next target"
    fi
done <"$candidate_file"

available="$(available_bytes)"
if (( available >= HIGH_WATERMARK_BYTES )); then
    log "reached the ${HIGH_WATERMARK_GIB} GiB target with $(human_bytes "$available") available"
else
    log "all discovered targets were cleaned, but only $(human_bytes "$available") is available"
fi
