#!/usr/bin/env bash

set +x
set -Eeuo pipefail

usage() {
    printf 'Usage: %s DAYS\n' "${0##*/}"
    printf 'Create one 1Password token for DAYS days with read/write access to all eligible vaults.\n'
    printf 'Stored at ${XDG_STATE_HOME:-$HOME/.local/state}/1password/service-account.token\n'
    printf 'Built-in Personal, Private, Employee and Team/Shared vaults cannot be included.\n'
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
    usage
    exit 0
fi

if [[ $# -ne 1 ]]; then
    usage >&2
    exit 2
fi

if [[ ! $1 =~ ^[1-9][0-9]*$ ]]; then
    usage >&2
    exit 2
fi

for command_name in op jq; do
    if ! command -v "$command_name" >/dev/null; then
        printf 'Missing required command: %s\n' "$command_name" >&2
        exit 1
    fi
done

days=$1
duration="${days}d"
timestamp=$(date +%Y%m%d-%H%M%S)
state_home=${XDG_STATE_HOME:-"$HOME/.local/state"}
token_dir="$state_home/1password"
token_file="$token_dir/service-account.token"
token_next=

cleanup() {
    if [[ -n $token_next ]]; then
        rm -f -- "$token_next"
    fi
}

trap cleanup EXIT

human_op() {
    env -u OP_SERVICE_ACCOUNT_TOKEN op "$@"
}

validate_scope() {
    local token_file=$1
    local expected_vault_ids=$2
    local actual_vault_ids

    actual_vault_ids=$(
        OP_SERVICE_ACCOUNT_TOKEN="$(<"$token_file")" op vault list --format=json |
            jq -cer 'map(.id) | sort'
    )

    if [[ $actual_vault_ids != "$expected_vault_ids" ]]; then
        printf 'Unexpected token vault scope; keeping the existing token file.\n' >&2
        exit 1
    fi
}

install -d -m 700 "$token_dir"
umask 077

vaults=$(
    human_op vault list --format=json |
        human_op vault get - --format=json |
        jq -s 'map({id, name, type})'
)
eligible_vaults=$(jq -c '[.[] | select(.type == "USER_CREATED")]' <<<"$vaults")
vault_count=$(jq 'length' <<<"$eligible_vaults")
if [[ $vault_count -eq 0 ]]; then
    printf 'No vaults eligible for service-account access were found.\n' >&2
    exit 1
fi

while IFS= read -r vault_name; do
    printf 'Excluded vault (unsupported by service accounts): %s\n' "$vault_name" >&2
done < <(jq -r '.[] | select(.type != "USER_CREATED") | .name' <<<"$vaults")

vault_args=()
while IFS= read -r vault_id; do
    vault_args+=(--vault "$vault_id:read_items,write_items")
done < <(jq -r '.[].id' <<<"$eligible_vaults")
expected_vault_ids=$(jq -c 'map(.id) | sort' <<<"$eligible_vaults")

token_next=$(mktemp "$token_dir/.service-account.token.next.XXXXXX")
human_op service-account create "cli-${days}d-$timestamp" \
    --expires-in="$duration" \
    "${vault_args[@]}" \
    --raw >"$token_next"

if [[ ! -s $token_next ]]; then
    printf '1Password returned an empty token; keeping the existing token file.\n' >&2
    exit 1
fi
chmod 600 "$token_next"
validate_scope "$token_next" "$expected_vault_ids"

mv -f -- "$token_next" "$token_file"
token_next=

printf 'Renewed one token for %s day(s), with read/write access to %s vault(s).\n' "$days" "$vault_count"
printf 'Expires around: %s\n' "$(date --date="+$days days" --iso-8601=seconds)"
printf 'Token file: %s\n' "$token_file"
