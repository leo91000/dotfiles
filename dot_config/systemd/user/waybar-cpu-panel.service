[Unit]
Description=Waybar CPU and RAM activity panels and rolling history
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=local.waybar.CpuPanel
ExecStart=/usr/bin/gjs -m %h/.config/waybar/cpu-panel/panel.js --background
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
