[Unit]
Description=Clean Cargo targets when disk space is low
ConditionPathIsDirectory=/home/leoc/projects

[Service]
Type=oneshot
ExecStart=%h/.local/bin/cargo-clean-low-disk
Environment=PATH=%h/.cargo/bin:%h/.local/bin:/usr/local/bin:/usr/bin
Environment=CARGO_TERM_COLOR=never
Nice=19
IOSchedulingClass=idle
IOSchedulingPriority=7
CPUWeight=10
IOWeight=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077
